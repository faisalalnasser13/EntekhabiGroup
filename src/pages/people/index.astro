---
import PersonCard from '../../components/PersonCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PEOPLE_SECTIONS, sortByLastName } from '../../utils/people';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

const people = await getCollection('people');

function sortByOrder(entries: CollectionEntry<'people'>[]) {
	return [...entries].sort((a, b) => a.data.order - b.data.order);
}

function filterByRoles(
	entries: CollectionEntry<'people'>[],
	roles: readonly string[],
) {
	return sortByLastName(entries.filter((p) => roles.includes(p.data.role)));
}

const piMembers = sortByOrder(people.filter((p) => p.data.role === 'pi'));

const sections = PEOPLE_SECTIONS.map((section) => ({
	...section,
	members: filterByRoles(people, section.roles),
}));
---

<BaseLayout title="People">
	<h1 class="page-title">People</h1>

	{
		piMembers.length > 0 && (
			<section class="people-pi-section">
				<div class="people-grid">
					{piMembers.map((entry) => (
						<PersonCard entry={entry} />
					))}
				</div>
			</section>
		)
	}

	{
		sections.map((section) => (
			<div class="people-section-block">
				<hr class="people-divider" />
				<section class="people-section">
					<h2 class="people-section-title">{section.title}</h2>
					<div class="people-grid">
						{section.members.map((entry) => (
							<PersonCard entry={entry} />
						))}
					</div>
				</section>
			</div>
		))
	}
</BaseLayout>
