---
import BaseLayout from '../../layouts/BaseLayout.astro';
import publicationsData from '../../data/publications.json';
import {
	groupPublicationsByYear,
	mergePublications,
	type Publication,
} from '../../utils/publications';
import { getCollection } from 'astro:content';

const manualPublications: Publication[] = (await getCollection('publications')).map(
	(entry) => ({
		title: entry.data.title,
		authors: entry.data.authors,
		venue: entry.data.venue,
		year: entry.data.year,
		doi: entry.data.doi ?? null,
		pdf: entry.data.pdf ?? null,
		code: entry.data.code ?? null,
		source: 'manual' as const,
	}),
);

const openAlexPublications: Publication[] = publicationsData.publications.map((entry) => ({
	title: entry.title,
	authors: entry.authors,
	venue: entry.venue,
	year: entry.year ?? 0,
	doi: entry.doi,
	pdf: entry.pdf,
	code: null,
	source: 'openalex' as const,
}));

const publications = mergePublications(openAlexPublications, manualPublications);
const byYear = groupPublicationsByYear(publications);
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Publications">
	<h1 class="page-title">Publications</h1>

	{
		years.map((year) => (
			<section class="pub-year-group">
				<h2 class="pub-year">{year}</h2>
				<ul class="pub-list">
					{byYear.get(year)!.map((pub) => (
						<li class="pub-item">
							<p class="pub-title">{pub.title}</p>
							<p class="pub-authors">{pub.authors}</p>
							{pub.venue && <p class="pub-venue">{pub.venue}</p>}
							{(pub.pdf || pub.code || pub.doi) && (
								<p class="pub-links">
									{pub.doi && (
										<a
											href={`https://doi.org/${pub.doi}`}
											target="_blank"
											rel="noopener noreferrer"
										>
											DOI
										</a>
									)}
									{pub.pdf && (
										<a href={pub.pdf} target="_blank" rel="noopener noreferrer">
											PDF
										</a>
									)}
									{pub.code && (
										<a href={pub.code} target="_blank" rel="noopener noreferrer">
											Code
										</a>
									)}
								</p>
							)}
						</li>
					))}
				</ul>
			</section>
		))
	}
</BaseLayout>
